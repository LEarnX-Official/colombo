// Only used if you deploy with Cloudflare Workers (Workers Builds).
// Cloudflare Pages ignores this file and uses the build settings in its dashboard.
// "build" makes `wrangler deploy` generate ./dist itself (dist/ is not committed),
// so the deploy works even if the dashboard build command only installs jinja2.
{
  "name": "drgiuseppecolombo",
  "compatibility_date": "2025-10-01",
  "build": { "command": "python3 build.py" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
